          "invalid_port": "Enter a port between 1 and 65535.",
          "invalid_timeout": "Enter a timeout between 1 and 30 seconds.",
          "invalid_polling_interval": "Enter a polling interval between 5 and 300 seconds.",
          "cannot_connect": "Unable to connect to the Viega module."
        }
      }
    },
